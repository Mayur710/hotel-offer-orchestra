# Copy to .env to override defaults (docker compose reads .env automatically).
# Every value below matches the docker-compose.yml default.

# API port
PORT=3000

# Infrastructure (docker-compose sets these per service; required when running outside compose)
REDIS_URL=redis://redis:6379
TEMPORAL_ADDRESS=temporal:7233
SUPPLIER_BASE_URL=http://app:3000

# Supplier outage simulation: set to "true" to make a mock supplier return 503
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
