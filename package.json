{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Aggregate overlapping hotel offers from two mock suppliers, dedupe by name, and filter by price using Redis.",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@temporalio/activity": "^1.26.0",
    "@temporalio/client": "^1.26.0",
    "@temporalio/worker": "^1.26.0",
    "@temporalio/workflow": "^1.26.0",
    "express": "^4.22.3",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@swc/core@1.16.22": true,
    "protobufjs@7.6.6": true,
    "protobufjs@8.8.1": true
  }
}
