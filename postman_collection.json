          ],
          "query": [
            {
              "key": "city",
              "value": "delhi"
            },
            {
              "key": "minPrice",
              "value": "5000"
            },
            {
              "key": "maxPrice",
              "value": "7500"
            }
          ]
        },
        "description": "Filters deduplicated Delhi hotels in Redis using ZRANGEBYSCORE between 5000 and 7500 inclusive."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const hotels = pm.response.json();",
              "",
              "pm.test('Response is an array', function () {",
              "  pm.expect(hotels).to.be.an('array');",
              "});",
              "",
              "pm.test('All hotel prices are within [5000, 7500]', function () {",
              "  pm.expect(hotels).to.have.lengthOf(4);",
              "  hotels.forEach(item => {",
              "    pm.expect(item.price).to.be.at.least(5000);",
              "    pm.expect(item.price).to.be.at.most(7500);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
