    {
      "name": "7. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Checks API health, Redis connectivity, and live availability of Supplier A and Supplier B. Returns 200 with status 'ok' (both suppliers up) or 'degraded' (one or both suppliers down), and 503 if Redis is down."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('Health payload reports redis and both suppliers', function () {",
              "  pm.expect(body.status).to.be.oneOf(['ok', 'degraded']);",
              "  pm.expect(body.redis).to.eql('up');",
              "  pm.expect(body.suppliers).to.be.an('object');",
              "  pm.expect(body.suppliers.supplierA).to.be.oneOf(['up', 'down']);",
              "  pm.expect(body.suppliers.supplierB).to.be.oneOf(['up', 'down']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Simulate Supplier B Down (Optional)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "delhi"
            }
          ]
        },
        "description": "Verifies graceful degradation when Supplier B is unavailable. The test script probes /health first: with Supplier B down it asserts that every offer comes from Supplier A; otherwise it verifies Supplier B offers are present (outage assertions skipped).\n\nHow to trigger the outage:\n1. Restart the `app` service with the `SUPPLIER_B_DOWN` env flag enabled:\n   `SUPPLIER_B_DOWN=true docker compose up -d app`\n2. Run this request (and `/health`, which will report `status: \"degraded\"` and `suppliers.supplierB: \"down\"`).\n3. Restore normal operation afterward:\n   `SUPPLIER_B_DOWN=false docker compose up -d app`\n\n(You can simulate Supplier A being down the same way using `SUPPLIER_A_DOWN=true`.)"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 despite Supplier B outage', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const hotels = pm.response.json();",
              "",
              "pm.test('Response is a non-empty array', function () {",
              "  pm.expect(hotels).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "const base = pm.variables.get('baseUrl') || 'http://localhost:3000';",
              "pm.sendRequest(base + '/health', function (err, res) {",
              "  var supplierB = 'unknown';",
              "  if (!err && res && res.code === 200) {",
              "    try {",
              "      supplierB = res.json().suppliers.supplierB;",
              "    } catch (e) {",
              "      supplierB = 'unknown';",
              "    }",
              "  }",
              "",
              "  if (supplierB === 'down') {",
              "    pm.test('All returned offers come from Supplier A when SUPPLIER_B_DOWN=true', function () {",
              "      hotels.forEach(item => {",
              "        pm.expect(item.supplier).to.eql('Supplier A');",
              "      });",
              "    });",
              "  } else {",
              "    pm.test('Supplier B is up - outage assertions skipped (restart app with SUPPLIER_B_DOWN=true to enable)', function () {",
              "      pm.expect(hotels.some(item => item.supplier === 'Supplier B')).to.be.true;",
              "    });",
              "  }",
              "});"
            ]
          }
        }
      ]
    }
