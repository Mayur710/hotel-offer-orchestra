{
  "info": {
    "_postman_id": "a7f3c9d2-4b18-4e6a-9c2f-81d5e3b0f4a1",
    "name": "Hotel Offer Orchestrator API",
    "description": "Postman Collection v2.1 for testing the Hotel Offer Orchestrator (Express, Temporal, Redis, Docker Compose).\n\nRun the whole collection against the stack in normal mode (docker compose up --build -d) - every item is green.\n\nOutage mode (optional): restart the app with SUPPLIER_B_DOWN=true docker compose up -d app and run item 8 - its assertions adapt to the live /health status. Items 1-7 assert normal-mode data and will legitimately differ while a supplier is down.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Delhi - Expected Overlaps (Deduplicated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hotels"
          ],
          "query": [
            {
              "key": "city",
              "value": "delhi"
            }
          ]
        },
        "description": "Fetches all deduplicated hotel offers for Delhi via the Temporal workflow and Redis sorted set. Overlapping hotels across Supplier A and Supplier B should resolve to the lowest price."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const hotels = pm.response.json();",
              "",
              "pm.test('Response has exactly 10 deduplicated hotels', function () {",
              "  pm.expect(hotels).to.be.an('array');",
              "  pm.expect(hotels).to.have.lengthOf(10);",
              "});",
              "",
              "pm.test('No duplicate hotel names (case-insensitive)', function () {",
              "  const normalizedNames = hotels.map(h => String(h.name).trim().toLowerCase());",
              "  const uniqueNames = new Set(normalizedNames);",
              "  pm.expect(uniqueNames.size).to.eql(normalizedNames.length);",
              "});",
              "",
              "pm.test('Each item has name, price, supplier, and commissionPct', function () {",
              "  hotels.forEach(item => {",
              "    pm.expect(item).to.be.an('object');",
              "    pm.expect(item.name).to.be.a('string').and.not.be.empty;",
              "    pm.expect(item.price).to.be.a('number').and.at.least(0);",
              "    pm.expect(item.supplier).to.be.oneOf(['Supplier A', 'Supplier B']);",
              "    pm.expect(item.commissionPct).to.be.a('number').and.at.least(0);",
              "  });",
              "});",
              "",
              "pm.test('Sorted ascending by price', function () {",
              "  for (let i = 1; i < hotels.length; i++) {",
              "    pm.expect(hotels[i].price).to.be.at.least(hotels[i - 1].price);",
              "  }",
              "});",
              "",
              "pm.test('Overlapping hotels resolve to the cheapest offer', function () {",
              "  const byName = {};",
              "  hotels.forEach(h => { byName[String(h.name).trim().toLowerCase()] = h; });",
              "  pm.expect(byName['holtin']).to.include({ price: 5340, supplier: 'Supplier B', commissionPct: 20 });",
              "  pm.expect(byName['radison']).to.include({ price: 5900, supplier: 'Supplier A', commissionPct: 13 });",
              "  pm.expect(byName['taj palace']).to.include({ price: 7900, supplier: 'Supplier B', commissionPct: 16 });",
              "  pm.expect(byName['oberoi grand']).to.include({ price: 9500, supplier: 'Supplier A', commissionPct: 15 });",
              "});"
            ]
          }
        }
      ]
    },
    {
